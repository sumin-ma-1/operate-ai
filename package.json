{
  "name": "operate-ai",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter @operate-ai/web dev",
    "dev:api": "cd apps/api && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "build:web": "pnpm --filter @operate-ai/web build",
    "build:schema": "pnpm --filter @operate-ai/workflow-schema exec tsc",
    "desktop:dev": "pnpm --filter @operate-ai/desktop desktop:dev",
    "desktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File packaging/build_windows.ps1"
  },
  "engines": {
    "node": ">=18"
  }
}
