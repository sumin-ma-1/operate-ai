{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window (local splash + navigated editor on :3000)",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:3000/*", "http://localhost:3000/*"]
  },
  "permissions": [
    "core:default",
    "opener:default"
  ]
}
