# Copy to deploy/open-space.env and fill in values.
# docker compose -f docker-compose.open-space.yml --env-file deploy/open-space.env up -d --build

POSTGRES_USER=operate
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=operate_community

# Same Google OAuth Web Client ID used by the browser (NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=881654052698-6i144s127dor6sv783ihcehb9edgr1ad.apps.googleusercontent.com

# Where "Open as new" should send users (their local editor)
NEXT_PUBLIC_LOCAL_EDITOR_URL=http://localhost:3000

# Public site origins allowed by the API (comma-separated). Example:
# CORS_ORIGINS=https://open.example.com,https://www.open.example.com
CORS_ORIGINS=

HTTP_PORT=80

# Optional: Cloudflare Tunnel URL to a home Forge instance (public server rarely needs this)
# FORGE_BASE_URL=https://forge-xxxx.trycloudflare.com
